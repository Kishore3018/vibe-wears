# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/vibe_wears

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Configuration (legacy - for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Razorpay Configuration (for payments)
# Get your keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_demo
RAZORPAY_KEY_SECRET=demo_secret

# OpenAI Configuration (for AI Virtual Try-On)
# Use either OPENAI_API_KEY or OPENAI_KEY
OPENAI_API_KEY=
OPENAI_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRYON_SIZE=1536x2048
OPENAI_TRYON_QUALITY=high
# If true, backend generates a local fallback try-on image when OpenAI key is missing
OPENAI_TRYON_LOCAL_FALLBACK=true

# Fast2SMS Configuration (for OTP)
# Get your FREE API key from https://www.fast2sms.com/
# Steps: 1. Register at fast2sms.com (FREE account)
#        2. Login -> Go to "Dev API" section
#        3. Copy your API Authorization Key
#        4. Paste it below
# Note: Free tier gives 10 SMS/day for testing
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
